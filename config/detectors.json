{
  "bruteforce": {
    "enabled": true,
    "metric": "failed_login_by_ip",

    "rules": {
      "5s": {
        "threshold": 8,
        "risk": 30
      },
      "1m": {
        "threshold": 30,
        "risk": 20
      },
      "5m": {
        "threshold": 100,
        "risk": 10
      }
    }
  },

  "ddos": {
    "enabled": true,
    "metric": "requests_by_ip",

    "rules": {
      "5s": {
        "threshold": 500,
        "risk": 60
      },
      "1m": {
        "threshold": 3000,
        "risk": 40
      },
      "5m": {
        "threshold": 12000,
        "risk": 20
      }
    }
  },

  "directory_scanner": {
    "enabled": true,

    "metrics": {
      "unique_uri": "uri_by_ip",
      "not_found": "status_by_ip"
    },

    "rules": {
      "5s": {
        "unique_uri_threshold": 15,
        "404_threshold": 10,
        "risk": 25
      },
      "1m": {
        "unique_uri_threshold": 60,
        "404_threshold": 40,
        "risk": 20
      },
      "5m": {
        "unique_uri_threshold": 150,
        "404_threshold": 100,
        "risk": 15
      }
    }
  },

  "ua_switching": {
    "enabled": true,
    "metric": "user_agent_by_ip",

    "rules": {
      "5s": {
        "distinct_threshold": 3,
        "risk": 20
      },
      "1m": {
        "distinct_threshold": 5,
        "risk": 15
      },
      "5m": {
        "distinct_threshold": 8,
        "risk": 10
      }
    }
  },

  "suspicious_uri": {
    "enabled": true,
    "metric": "path",

    "watchlist": [
      "/admin",
      "/server-status",
      "/.env",
      "/.git/config"
    ],

    "risk": 15
  }
}