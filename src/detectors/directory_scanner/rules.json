{
  "enabled": true,
  "trigger": "rollup",
  "metrics": {
    "uri": "uri_by_ip",
    "status": "status_by_ip"
  },

  "rules": {
    "short": {
      "unique_uri_threshold": 15,
      "404_threshold": 10,
      "risk": 25
    },
    "medium": {
      "unique_uri_threshold": 60,
      "404_threshold": 40,
      "risk": 20
    },
    "long": {
      "unique_uri_threshold": 150,
      "404_threshold": 100,
      "risk": 15
    }
  }
}